{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LoL Translator",
  "version": "0.1.0",
  "identifier": "com.lightmarexo.loltranslator",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LoL Translator",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "resources": {
      "../analyzer/main.py": "analyzer/main.py",
      "../analyzer/runtime_cli.py": "analyzer/runtime_cli.py",
      "../analyzer/runtime_core.py": "analyzer/runtime_core.py",
      "../analyzer/app_dictionary/__init__.py": "analyzer/app_dictionary/__init__.py",
      "../analyzer/app_dictionary/dictionary.py": "analyzer/app_dictionary/dictionary.py",
      "../analyzer/app_dictionary/official-16.18.1.json": "analyzer/app_dictionary/official-16.18.1.json",
      "../analyzer/app_dictionary/aliases.json": "analyzer/app_dictionary/aliases.json",
      "../analyzer/ocr_evaluation/__init__.py": "analyzer/ocr_evaluation/__init__.py",
      "../analyzer/ocr_evaluation/core.py": "analyzer/ocr_evaluation/core.py",
      "../analyzer/ocr_evaluation/preprocessing.py": "analyzer/ocr_evaluation/preprocessing.py",
      "../analyzer/ocr_evaluation/run_paddle.py": "analyzer/ocr_evaluation/run_paddle.py",
      "../analyzer/ocr_evaluation/runner_common.py": "analyzer/ocr_evaluation/runner_common.py",
      "../analyzer/translation_evaluation/__init__.py": "analyzer/translation_evaluation/__init__.py",
      "../analyzer/translation_evaluation/evaluate.py": "analyzer/translation_evaluation/evaluate.py",
      "../analyzer/translation_evaluation/prompts-instruct.json": "analyzer/translation_evaluation/prompts-instruct.json",
      "../analyzer/translation_evaluation/glossary.json": "analyzer/translation_evaluation/glossary.json"
    },
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
